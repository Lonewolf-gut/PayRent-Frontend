# =============================================================================
# PayRent Frontend — environment variables
# Copy to payrent-frontend/.env
# =============================================================================

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHOW_DEV_OTP="true"

# Backend API (used for Next.js rewrites and direct server calls)
API_URL="http://localhost:3001"

# Optional for local dev OTP toasts on /verify-phone when backend omits devCode.
# Copy the same DATABASE_URL from PayRent-Backend/.env
# DATABASE_URL="postgresql://user:password@localhost:5432/payrent"

# Optional: set in production when frontend and backend are on different domains
# NEXT_PUBLIC_API_URL="https://api.yourdomain.com"

# S3 public base URL for property images (must match PayRent-Backend S3_PUBLIC_URL)
# NEXT_PUBLIC_S3_PUBLIC_URL="https://your-bucket.s3.eu-west-1.amazonaws.com"
# S3_PUBLIC_URL="https://your-bucket.s3.eu-west-1.amazonaws.com"

# --- Auth (browser session cookies for NextAuth on the frontend) ---
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
