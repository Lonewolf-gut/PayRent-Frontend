{
  "name": "payrent-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000 --webpack",
    "dev:webpack": "next dev --port 3000 --webpack",
    "setup:env": "node scripts/setup-env.js",
    "clean": "node scripts/clean-cache.js",
    "dev:turbo": "next dev --port 3000",
    "build": "npm run db:generate && next build --webpack",
    "postinstall": "npm run db:generate || echo Prisma generate skipped - run npm run db:generate manually",
    "start": "next start --port 3000",
    "lint": "eslint",
    "db:generate": "prisma generate --schema prisma/schema.prisma"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
